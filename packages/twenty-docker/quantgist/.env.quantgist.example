# Twenty Docker — see ../.env.example for server secrets.

# OpenClaw on Mac — Twenty MCP
SERVER_URL_FOR_OPENCLAW=http://localhost:3000
MCP_ENDPOINT=http://localhost:3000/mcp
# TWENTY_QUANTGIST_API_KEY → ~/.openclaw/credentials/twenty-quantgist-api-key.txt

# Postiz — social scheduling (agents)
POSTIZ_API_URL=https://smm.quantgist.com/api
# POSTIZ_API_KEY → ~/.openclaw/credentials/postiz-quantgist-api-key.txt
# Postiz Agents chat (OpenClaw bridge) → ~/.openclaw/credentials/postiz-openclaw-gateway-token.txt
# See bootstrap-postiz-agent-chat.sh — no OPENAI_API_KEY

# Canva Connect API
# CANVA_* → ~/.openclaw/credentials/canva-quantgist.env (chmod 600)

# Production Twenty MCP (if not using local Docker)
# MCP_ENDPOINT=https://crm.quantgist.com/mcp
